# ============================================
# Saransh — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# --- AWS Credentials ---
# Get these from IAM Console → Users → Security Credentials → Access Keys
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_DEFAULT_REGION=us-east-1

# --- Bedrock Model IDs ---
# Amazon Nova Micro (cheapest LLM: $0.035/1M input, $0.14/1M output)
BEDROCK_LLM_MODEL_ID=amazon.nova-micro-v1:0
# Amazon Titan Embed Text v2 ($0.02/1M tokens)
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# --- App Settings ---
# Set to "true" to use Bedrock, "false" for local fallback (no AWS needed)
USE_BEDROCK=true
# Maximum file upload size in MB
MAX_FILE_SIZE_MB=10
# Rate limit: max requests per minute per IP
RATE_LIMIT_PER_MINUTE=10
# Rate limit: max file uploads per minute per IP
UPLOAD_LIMIT_PER_MINUTE=3

# --- CORS ---
# Comma-separated allowed origins (frontend URL)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend (set in Vercel dashboard for production) ---
VITE_API_URL=http://localhost:8000
